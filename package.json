{
  "name": "virtual-office",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev --workspace @vo/client",
    "build": "npm run build --workspace @vo/client",
    "preview": "npm run preview --workspace @vo/client",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "validate:map": "node packages/shared/src/cli/validate-map.ts apps/client/public/assets/map/map.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate:map && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
